# Copie para .env.docker e preencha somente o provedor usado no contêiner.
# Execute: docker compose --env-file .env.docker up --build

# OpenAI
LLM_PRIMARY_PROVIDER=openai
OPENAI_MODEL=gpt-5.2
OPENAI_API_KEY=sk-substitua-por-sua-chave

# IpeaGPT / OpenAI-compatible (use no lugar do bloco OpenAI)
# LLM_PRIMARY_PROVIDER=openai_compatible
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://servidor-interno/v1
# LLM_MODEL=nome-do-modelo
# LLM_API_KEY=substitua-por-um-token

# Grounding externo (opcional)
# OPENALEX_API_KEY=chave-opcional
# OPENALEX_EMAIL=voce@exemplo.org
